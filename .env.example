# JRE staging environment template.
# Copy to .env.staging for local staging runs:
#   cp .env.example .env.staging
# CI runs without this file — docker-compose.staging.yml marks env_file
# optional and sets everything critical inline.
#
# NOTE: only DATABASE_URL is consumed by application code today; the rest
# are reserved for configuration wiring.

# Environment
ENVIRONMENT=staging
LOG_LEVEL=info

# API Settings
HOST=0.0.0.0
PORT=8000

# CORS & Security
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ephemeris Path
EPHEMERIS_PATH=datasets/ephemeris

# Database
DATABASE_URL=postgresql://jre_user:jre_staging_password@db:5432/jre_staging_db
